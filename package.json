{
  "name": "school-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/seo.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "node tests/database.mjs",
    "test:edge": "npx --yes deno test tests/edge_test.ts",
    "check:edge": "npx --yes deno check supabase/functions/public-api/index.ts supabase/functions/upload/index.ts supabase/functions/school-accounts/index.ts",
    "setup:admin": "node scripts/bootstrap-admin.mjs",
    "test:upgrade": "node tests/upgrade.mjs",
    "test:accounts": "npx --yes deno test tests/accounts_test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.1"
  }
}
